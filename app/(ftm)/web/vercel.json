{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ftm_web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ftm_ortools",
          "format": "url",
          "env": "FTM_INTERNAL_ORTOOLS_URL"
        }
      ]
    },
    "ftm_ortools": {
      "root": "python",
      "framework": "fastapi",
      "entrypoint": "ortools_api:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "ftm_web" }
    }
  ]
}
